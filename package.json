{
  "name": "angrykitten",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/build-headers.mjs",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check && eslint . && prettier --check . && npm test",
    "favicons": "node scripts/build-favicons.mjs",
    "i18n:sync": "node scripts/sync-i18n.mjs",
    "press": "node scripts/build-press.mjs",
    "predev": "node scripts/build-press.mjs && node scripts/build-og.mjs",
    "prebuild": "node scripts/build-press.mjs && node scripts/build-og.mjs",
    "og": "node scripts/build-og.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^6.4.8",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.166.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.5",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.63.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "vite": "^7.3.8"
  }
}
