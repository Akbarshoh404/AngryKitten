---
/**
 * BaseLayout: <html>, <head> (SEO basics, hreflang, fonts) and the skip link.
 * Every page goes through this layout, usually via PageLayout.
 */
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/dm-sans/wght.css';
import '../styles/global.css';
import siteData from '../content/site.json';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import {
  locales,
  localeLabels,
  localizePath,
  stripLocale,
  useTranslations,
  defaultLocale,
  type Locale,
} from '../i18n/utils';

export type BaseProps = {
  locale: Locale;
  title?: string;
  description?: string;
  /** Colour of the page's first screen; sets the browser theme-color. Sections set their own data-theme. */
  theme?: 'light' | 'dark' | 'tangerine';
  noindex?: boolean;
  /** Set false for pages that have no translated twins (e.g. 404). */
  alternates?: boolean;
  /** Open Graph image path (from scripts/build-og.mjs), e.g. "/og/work.png". */
  ogImage?: string;
};

type Props = BaseProps;
const {
  locale,
  title,
  description,
  theme = 'light',
  noindex = false,
  alternates = true,
  ogImage = '/og/home.png',
} = Astro.props;
const t = useTranslations(locale);

const pageTitle = title ?? t('meta.defaultTitle');
const pageDescription = description ?? t('meta.defaultDescription');
const site = Astro.site ?? new URL('https://angrykitten.uz');
const path = stripLocale(Astro.url.pathname);
const canonical = new URL(localizePath(path, locale), site).href;
const ogUrl = new URL(ogImage, site).href;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AngryKitten',
  url: site.href,
  logo: new URL('/icon-512.png', site).href,
  email: siteData.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Tashkent', addressCountry: 'UZ' },
  sameAs: [siteData.googlePlay, ...Object.values(siteData.socials).filter(Boolean)],
};
const themeColor = theme === 'tangerine' ? '#ff5a1f' : theme === 'dark' ? '#2b1640' : '#faf7f2';
---

<!doctype html>
<html lang={localeLabels[locale].hreflang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // First page of the visit: play the one-off intro (nav drop-in).
      try {
        if (!sessionStorage.getItem('ak-seen')) {
          document.documentElement.classList.add('ak-first');
          sessionStorage.setItem('ak-seen', '1');
        }
      } catch {
        /* storage blocked */
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates &&
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={localeLabels[l].hreflang}
          href={new URL(localizePath(path, l), site).href}
        />
      ))}
    {alternates && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(localizePath(path, defaultLocale), site).href}
      />
    )}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Preload only the display face (hero headline); DM Sans swaps in. -->
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={t('meta.siteName')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : locale === 'uz' ? 'uz_UZ' : 'ru_RU'} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="ak-skip">
      {t('a11y.skipToContent')}
    </a>
    <slot />
    <script>
      // Site-wide motion: reveals, parallax, tilt, magnetic buttons, drag (src/scripts/motion.ts).
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  @layer components {
    .ak-skip {
      position: fixed;
      top: 12px;
      left: 12px;
      z-index: 100;
      padding: 12px 20px;
      border: 3px solid var(--color-ink);
      border-radius: var(--radius-pill);
      background: var(--color-gold);
      color: var(--color-ink);
      font-weight: 700;
      text-decoration: none;
      transform: translateY(-200%);
    }
    .ak-skip:focus-visible {
      transform: none;
    }
  }
</style>
