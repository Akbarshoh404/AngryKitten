---
/** Home contact — Figma 38:907: header + contact methods left, quick form card right. Mobile: link to /contact. */
import SectionHeader from '../../ui/SectionHeader.astro';
import Button from '../../ui/Button.astro';
import ContactMethods from '../ContactMethods.astro';
import ContactFormIsland from '../ContactFormIsland.astro';
import { siteText } from '../../../lib/site';
import { fill, getDict, localizePath, type Locale } from '../../../i18n/utils';

type Props = { locale: Locale };
const { locale } = Astro.props;
const d = getDict(locale).home.contact;
---

<section class="section-y" aria-labelledby="contact-title" id="contact">
  <div class="container-page grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,640px)_minmax(0,560px)] lg:justify-between lg:gap-20">
    <div class="flex flex-col gap-8">
      <SectionHeader
        id="contact-title"
        eyebrow={d.eyebrow}
        title={d.title}
        body={fill(d.body, { replyTime: siteText(locale).replyTime })}
      />
      <ContactMethods locale={locale} />
      <Button href={localizePath('/contact#start', locale)} variant="accent" block class="md:hidden">
        {d.mobileCta}
      </Button>
    </div>
    <div class="ak-form-card max-md:hidden">
      <ContactFormIsland locale={locale} variant="quick" showTitle />
    </div>
  </div>
</section>
