---
/** The four contact methods (Figma 37:72), filled from src/content/site.json. */
import ContactMethod from '../cards/ContactMethod.astro';
import site from '../../content/site.json';
import { siteText } from '../../lib/site';
import { useTranslations, type Locale } from '../../i18n/utils';

type Props = { locale: Locale; class?: string };
const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
const isPlaceholder = (v: string) => v.startsWith('[');
const tg =
  site.telegram.url ||
  (isPlaceholder(site.telegram.handle) ? undefined : `https://t.me/${site.telegram.handle.replace('@', '')}`);
const tel = isPlaceholder(site.phone) ? undefined : `tel:${site.phone.replace(/[^\d+]/g, '')}`;
---

<ul class:list={['flex flex-col gap-5', className]}>
  <li>
    <ContactMethod
      kind="email"
      label={t('contactMethods.email')}
      value={site.email}
      href={`mailto:${site.email}`}
    />
  </li>
  <li>
    <ContactMethod
      kind="telegram"
      label={t('contactMethods.telegram')}
      value={site.telegram.handle}
      href={tg}
    />
  </li>
  <li>
    <ContactMethod kind="phone" label={t('contactMethods.phone')} value={site.phone} href={tel} />
  </li>
  <li>
    <ContactMethod kind="studio" label={t('contactMethods.studio')} value={siteText(locale).address} />
  </li>
</ul>
