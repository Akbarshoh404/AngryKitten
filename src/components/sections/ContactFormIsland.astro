---
/** Hydrates the ContactForm island with translated labels and site settings. */
import { getImage } from 'astro:assets';
import ContactForm from '../islands/ContactForm';
import site from '../../content/site.json';
import { siteText } from '../../lib/site';
import sticker from '../../assets/brand/sticker.png';
import { getDict, type Locale } from '../../i18n/utils';

type Props = { locale: Locale; variant: 'quick' | 'full'; showTitle?: boolean };
const { locale, variant, showTitle = false } = Astro.props;
const successImage = (await getImage({ src: sticker, width: 192, format: 'webp' })).src;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<ContactForm
  client:visible
  variant={variant}
  labels={getDict(locale).form}
  locale={locale}
  replyTime={siteText(locale).replyTime}
  email={site.email}
  turnstileSiteKey={turnstileSiteKey || undefined}
  showTitle={showTitle}
  successImage={successImage}
/>
