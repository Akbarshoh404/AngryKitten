---
/**
 * Card / Team member — Figma 37:21. 4:5 portrait (or the faded-cat placeholder),
 * orange role badge, name, job title, and Telegram / LinkedIn pills when links exist.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import mark from '../../assets/brand/mark.png';

type Props = {
  name: string;
  jobTitle: string;
  badge?: string;
  photo?: ImageMetadata;
  telegram?: string;
  linkedin?: string;
  headingLevel?: 'h3' | 'h4';
  class?: string;
};
const {
  name,
  jobTitle,
  badge,
  photo,
  telegram,
  linkedin,
  headingLevel: Heading = 'h3',
  class: className,
} = Astro.props;
const links = [
  { label: 'Telegram', href: telegram },
  { label: 'LinkedIn', href: linkedin },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
---

<article class:list={['ak-team', className]}>
  <div class="ak-team__photo">
    {photo ? (
      <Image
        src={photo}
        alt={name}
        widths={[300, 450, 600]}
        sizes="(min-width: 1280px) 300px, (min-width: 768px) 30vw, 80vw"
        class="ak-team__img"
      />
    ) : (
      <Image src={mark} alt="" width={120} height={120} densities={[1, 2]} class="ak-team__placeholder" />
    )}
    {badge && <span class="ak-team__badge">{badge}</span>}
  </div>
  <div class="ak-team__body">
    <Heading class="ak-team__name">{name}</Heading>
    <p class="text-meta text-fg-2">{jobTitle}</p>
    {links.length > 0 && (
      <ul class="ak-team__links">
        {links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer" class="ak-team__link">
              {l.label}
              <span class="sr-only">: {name}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  @layer components {
    .ak-team {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 3px solid var(--border-strong);
      border-radius: var(--radius-card);
      background: var(--bg-surface);
      box-shadow: var(--shadow-sticker);
      transition:
        transform 250ms var(--ease-spring),
        box-shadow 250ms var(--ease-out);
    }
    @media (hover: hover) {
      .ak-team:hover {
        transform: translateY(-4px) rotate(-0.5deg);
        box-shadow: 10px 10px 0 0 var(--color-ink);
      }
    }
    .ak-team__photo {
      position: relative;
      display: grid;
      place-items: center;
      aspect-ratio: 294 / 320;
      overflow: hidden;
      border-bottom: 3px solid var(--border-strong);
      background: var(--bg-sunken);
    }
    .ak-team__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .ak-team__placeholder {
      width: 120px;
      height: 120px;
      opacity: 0.3;
    }
    .ak-team__badge {
      position: absolute;
      top: 16px;
      left: 16px;
      padding: 6px 12px;
      border: 2px solid var(--color-ink);
      border-radius: var(--radius-pill);
      background: var(--bg-accent);
      color: var(--color-ink);
      font-weight: 700;
      font-size: 0.75rem;
      line-height: 1.3;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .ak-team__body {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: 6px;
      padding: 18px 22px 22px;
    }
    .ak-team__name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.5rem;
      line-height: 1.15;
      letter-spacing: -0.008em;
    }
    .ak-team__links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding-top: 10px;
    }
    .ak-team__link {
      display: inline-flex;
      align-items: center;
      min-height: 36px;
      padding: 6px 12px;
      border: 2px solid var(--border-strong);
      border-radius: var(--radius-pill);
      color: var(--text-primary);
      font-weight: 500;
      font-size: 0.9375rem;
      line-height: 1.3;
      text-decoration: none;
      transition: background-color 150ms var(--ease-out);
    }
    .ak-team__link:hover {
      background: var(--bg-highlight);
      color: var(--color-ink);
    }
  }
</style>
