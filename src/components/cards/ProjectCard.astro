---
/**
 * Card / Project — Figma 33:96 (Default + Hover).
 * Whole card is one link (stretched link on the title). Hover/focus: lifts 4px,
 * shadow grows to 12px, banner zooms to 104%, CTA turns orange and its arrow slides.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from '../ui/Tag.astro';
import Arrow from '../../assets/icons/arrow.svg';

type Props = {
  href: string;
  name: string;
  meta: string;
  description: string;
  kind: 'game' | 'app';
  kindLabel: string;
  icon: ImageMetadata;
  banner: ImageMetadata;
  cta: string;
  headingLevel?: 'h2' | 'h3';
  external?: boolean;
  class?: string;
};
const {
  href,
  name,
  meta,
  description,
  kind,
  kindLabel,
  icon,
  banner,
  cta,
  headingLevel: Heading = 'h3',
  external = false,
  class: className,
} = Astro.props;
const linkAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<article class:list={['ak-pcard', className]}>
  <div class="ak-pcard__media">
    <Image
      src={banner}
      alt=""
      widths={[400, 640, 800, 1024]}
      sizes="(min-width: 1280px) 400px, (min-width: 768px) 45vw, 90vw"
    />
  </div>
  <div class="ak-pcard__body">
    <div class="ak-pcard__title-row">
      <Image src={icon} alt="" width={52} height={52} densities={[1, 2]} class="ak-pcard__icon" />
      <div class="ak-pcard__name">
        <Heading class="ak-pcard__heading">
          <a href={href} class="ak-pcard__link" {...linkAttrs}>
            {name}
          </a>
        </Heading>
        <p class="text-meta text-fg-2">{meta}</p>
      </div>
      <Tag kind={kind}>{kindLabel}</Tag>
    </div>
    <p class="text-body-s text-fg-2">{description}</p>
    <p class="ak-pcard__cta text-label-m" aria-hidden="true">
      {cta}
      <Arrow width={20} height={20} />
    </p>
  </div>
</article>

<style>
  @layer components {
    .ak-pcard {
      position: relative;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 3px solid var(--border-strong);
      border-radius: var(--radius-card);
      background: var(--bg-surface);
      box-shadow: var(--shadow-sticker);
      transition:
        transform 250ms var(--ease-spring),
        box-shadow 250ms var(--ease-out);
    }
    .ak-pcard__media {
      aspect-ratio: 400 / 196;
      overflow: hidden;
      border-bottom: 3px solid var(--border-strong);
      background: var(--bg-sunken);
    }
    .ak-pcard__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 400ms var(--ease-out);
    }
    .ak-pcard__body {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: 14px;
      padding: 20px 24px 24px;
    }
    .ak-pcard__title-row {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .ak-pcard__icon {
      flex: none;
      width: 52px;
      height: 52px;
      border: 2px solid var(--color-ink);
      border-radius: 14px;
      object-fit: cover;
    }
    .ak-pcard__name {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }
    .ak-pcard__heading {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.5rem;
      line-height: 1.15;
      letter-spacing: -0.008em;
    }
    .ak-pcard__link {
      color: inherit;
      text-decoration: none;
    }
    /* Stretched link: the whole card is clickable. */
    .ak-pcard__link::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: inherit;
    }
    .ak-pcard__link:focus-visible {
      outline: none;
    }
    .ak-pcard:has(.ak-pcard__link:focus-visible) {
      outline: 3px solid var(--border-strong);
      outline-offset: 4px;
    }
    .ak-pcard__cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: auto;
      color: var(--text-primary);
      transition:
        color 150ms var(--ease-out),
        gap 150ms var(--ease-out);
    }

    /* Hover state (Figma 33:82). Real :hover only on devices that can hover,
       so taps on touch screens don't leave the card stuck "lifted". */
    .ak-pcard.is-hover,
    .ak-pcard:has(.ak-pcard__link:focus-visible) {
      transform: translateY(-4px);
      box-shadow: 12px 12px 0 0 var(--color-ink);
    }
    .ak-pcard.is-hover .ak-pcard__media img {
      transform: scale(1.04);
    }
    /* Figma uses tabby-deep here; rust (text-accent) keeps the 15px label at 4.5:1 on white. */
    .ak-pcard.is-hover .ak-pcard__cta,
    .ak-pcard:has(.ak-pcard__link:focus-visible) .ak-pcard__cta {
      color: var(--text-accent);
      gap: 14px;
    }
    @media (hover: hover) {
      .ak-pcard:hover {
        transform: translateY(-4px);
        box-shadow: 12px 12px 0 0 var(--color-ink);
      }
      .ak-pcard:hover .ak-pcard__media img {
        transform: scale(1.04);
      }
      .ak-pcard:hover .ak-pcard__cta {
        color: var(--text-accent);
        gap: 14px;
      }
    }
    .ak-pcard:active {
      transform: translateY(-1px);
      box-shadow: var(--shadow-sticker);
    }
  }
</style>
