---
/**
 * Site navigation — Figma "Nav / Desktop" (4:66) and "Nav / Mobile" (4:83).
 * A floating pill bar, fixed to the top. It shrinks once the page scrolls and
 * gets a sticker shadow when it no longer sits over a [data-hero] section.
 * Below 1024px the links collapse into the MobileMenu sheet.
 */
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import LangSwitch from './LangSwitch.astro';
import MobileMenu from './MobileMenu.astro';
import MenuIcon from '../../assets/icons/menu.svg';
import { mainNav, ctaHref, isActive } from '../../config/nav';
import { localizePath, stripLocale, useTranslations, type Locale } from '../../i18n/utils';

type Props = { locale: Locale; counts?: Partial<Record<string, number>> };
const { locale, counts } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
---

<header class="ak-nav" data-nav>
  <div class="ak-nav__inner">
    <div class="ak-nav__bar">
      <a href={localizePath('/', locale)} class="ak-nav__home" aria-label={t('a11y.home')}>
        <Logo size="L" class="ak-nav__logo" />
      </a>

      <nav aria-label={t('a11y.mainNav')} class="max-lg:hidden">
        <ul class="ak-nav__links text-label-l">
          {mainNav.map((item) => (
            <li>
              <a
                href={localizePath(item.href, locale)}
                aria-current={isActive(current, item.href) ? 'page' : undefined}
              >
                {t(item.key)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="ak-nav__actions max-lg:hidden">
        <LangSwitch locale={locale} />
        <Button href={localizePath(ctaHref, locale)} variant="primary" size="M">
          {t('nav.cta')}
        </Button>
      </div>

      <button
        type="button"
        class="ak-nav__menu-btn lg:hidden"
        aria-label={t('a11y.openMenu')}
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-open
      >
        <MenuIcon width={22} height={22} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<MobileMenu locale={locale} counts={counts} />

<script>
  // Two IntersectionObservers instead of a scroll handler: no layout reads while scrolling.
  //  - data-scrolled: once a 24px sentinel at the top of the page leaves the viewport.
  //  - data-solid (sticker shadow): when no [data-hero] section sits under the bar's bottom edge.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const bar = nav?.querySelector<HTMLElement>('.ak-nav__bar');
  if (nav && bar) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:24px;pointer-events:none';
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) =>
      nav.toggleAttribute('data-scrolled', !entry!.isIntersecting),
    ).observe(sentinel);

    const heroes = Array.from(document.querySelectorAll<HTMLElement>('[data-hero]'));
    const under = new Set<Element>();
    let heroObserver: IntersectionObserver | undefined;
    const watchHeroes = () => {
      heroObserver?.disconnect();
      under.clear();
      // A 1px band at the bar's bottom edge (read once per resize, not per frame).
      // Layout offsets, not getBoundingClientRect: the first-visit drop-in animation translates the
      // bar above the viewport, which would give a negative (invalid) rootMargin. The header is
      // fixed at top:0, so offsets inside it are viewport coordinates.
      const line = Math.max(1, Math.round(bar.offsetTop + bar.offsetHeight));
      heroObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) under.add(e.target);
            else under.delete(e.target);
          }
          nav.toggleAttribute('data-solid', under.size === 0);
        },
        { rootMargin: `-${line}px 0px -${Math.max(0, innerHeight - line - 1)}px 0px` },
      );
      heroes.forEach((h) => heroObserver!.observe(h));
      if (!heroes.length) nav.toggleAttribute('data-solid', true);
    };
    watchHeroes();
    let resizeTimer = 0;
    addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(watchHeroes, 150);
    });
  }
</script>

<style>
  @layer components {
    .ak-nav {
      position: fixed;
      inset: 0 0 auto;
      z-index: 50;
      pointer-events: none;
    }
    .ak-nav__inner {
      max-width: 1440px;
      margin-inline: auto;
      padding: 12px 12px 4px;
      transition: padding 250ms var(--ease-out);
    }
    @media (min-width: 1024px) {
      .ak-nav__inner {
        padding: 24px 48px 8px;
      }
      .ak-nav[data-scrolled] .ak-nav__inner {
        padding-top: 12px;
      }
    }
    .ak-nav__bar {
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 6px 6px 6px 16px;
      border: 2.5px solid var(--color-ink);
      border-radius: var(--radius-pill);
      background: var(--color-paper);
      color: var(--color-ink);
      box-shadow: 0 0 0 0 var(--color-ink);
      transition:
        padding 250ms var(--ease-out),
        box-shadow 250ms var(--ease-out);
    }
    @media (min-width: 1024px) {
      .ak-nav__bar {
        padding: 12px 12px 12px 24px;
        border-width: 3px;
      }
      .ak-nav[data-scrolled] .ak-nav__bar {
        padding-block: 8px;
      }
    }
    .ak-nav[data-solid] .ak-nav__bar {
      box-shadow: var(--shadow-sticker-sm);
    }
    /* The bar is always paper, so pin its text colours to the light theme. */
    .ak-nav__bar {
      --text-primary: var(--color-ink);
      --text-secondary: var(--color-muted);
      --bg-accent: var(--color-tabby);
    }

    /* One logo image for both sizes: 36px mark on mobile, 44px on desktop (Figma 4:84 / 4:67). */
    @media (max-width: 1023px) {
      .ak-nav__home :global(.ak-logo) {
        gap: 8px;
      }
      .ak-nav__home :global(.ak-logo__mark) {
        width: 36px;
        height: 36px;
      }
      .ak-nav__home :global(.ak-logo__word) {
        font-size: 1.333rem;
      }
    }
    .ak-nav__home {
      display: inline-flex;
      border-radius: var(--radius-pill);
      color: inherit;
      text-decoration: none;
    }

    .ak-nav__links {
      display: flex;
      gap: clamp(24px, 2.8vw, 40px);
    }
    .ak-nav__links a {
      position: relative;
      display: inline-block;
      padding-block: 6px;
      color: inherit;
      text-decoration: none;
    }
    .ak-nav__links a::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 3px;
      border-radius: 3px;
      background: var(--color-tabby);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 200ms var(--ease-out);
    }
    .ak-nav__links a:hover::after,
    .ak-nav__links a[aria-current='page']::after {
      transform: scaleX(1);
    }

    .ak-nav__actions {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .ak-nav__menu-btn {
      display: inline-grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border-radius: var(--radius-pill);
      background: var(--color-ink);
      color: var(--color-paper);
      cursor: pointer;
      transition: transform 150ms var(--ease-spring);
    }
    .ak-nav__menu-btn:active {
      transform: scale(0.92);
    }
  }
</style>
