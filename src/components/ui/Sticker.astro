---
/**
 * Sticker: a tilted pill label with the 3px ink outline + hard shadow.
 * Wobbles slightly on hover (Figma UX notes, section 6 of the brief).
 */
type Props = {
  tone?: 'paper' | 'gold' | 'tabby' | 'ink';
  tilt?: number;
  size?: 'L' | 'M';
  class?: string;
  as?: 'span' | 'p' | 'div';
  /** Let visitors grab and fling it (springs back). */
  drag?: boolean;
};
const {
  tone = 'paper',
  tilt = 0,
  size = 'L',
  class: className,
  as: Tag = 'span',
  drag = false,
} = Astro.props;
---

<Tag
  data-drag={drag || undefined}
  class:list={['ak-sticker', `ak-sticker--${tone}`, `ak-sticker--${size}`, className]}
  style={`--tilt:${tilt}deg`}
>
  <slot />
</Tag>

<style>
  @layer components {
    .ak-sticker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border: 3px solid var(--color-ink);
      border-radius: var(--radius-pill);
      box-shadow: var(--shadow-sticker);
      font-family: var(--font-sans);
      font-weight: 500;
      font-size: 1.0625rem;
      line-height: 1.3;
      white-space: nowrap;
      color: var(--color-ink);
      rotate: var(--tilt);
    }
    .ak-sticker--M {
      padding: 8px 14px;
      border-width: 2.5px;
    }
    .ak-sticker--paper {
      background: var(--color-paper);
    }
    .ak-sticker--gold {
      background: var(--color-gold);
    }
    .ak-sticker--tabby {
      background: var(--color-tabby);
    }
    .ak-sticker--ink {
      background: var(--color-ink);
      color: var(--color-paper);
    }
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .ak-sticker:hover {
        animation: var(--animate-wobble);
      }
    }
  }
</style>
