---
/**
 * Phone with swipeable screenshots (case-study hero). The screen is a native scroll-snap
 * track (touch swipe, trackpad, keyboard scrolling all work); arrow buttons and dots are
 * enhanced by a few lines of script. No framework, so the hero paints immediately.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  images: { src: ImageMetadata; alt: string }[];
  label: string;
  labels: { prev: string; next: string; goTo: string };
  width?: string;
  class?: string;
};
const { images, label, labels, width = '300px', class: className } = Astro.props;
---

<div
  class:list={['ak-carousel', className]}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  style={`--phone-w:${width}`}
  data-carousel
>
  <div class="ak-phone">
    <div class="ak-phone__body has-shadow">
      <div class="ak-phone__bezel"></div>
      <div class="ak-phone__screen">
        {/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex -- a scrollable region must be keyboard-focusable (WCAG 2.1.1) */}
        <ul class="ak-carousel__track" data-track tabindex="0" aria-label={label}>
          {images.map((img, i) => (
            <li
              class="ak-carousel__slide"
              aria-roledescription="slide"
              aria-label={`${i + 1} / ${images.length}`}
            >
              <Image
                src={img.src}
                alt={img.alt}
                widths={[300, 450, 600, 720].filter((w) => w <= img.src.width)}
                sizes={width}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                class:list={['ak-phone__img', img.src.width / img.src.height > 0.7 && 'is-contain']}
                draggable="false"
              />
            </li>
          ))}
        </ul>
      </div>
      <div class="ak-phone__glare" aria-hidden="true"></div>
      <div class="ak-phone__camera" aria-hidden="true"></div>
      <div class="ak-phone__btn ak-phone__btn--power" aria-hidden="true"></div>
      <div class="ak-phone__btn ak-phone__btn--volume" aria-hidden="true"></div>
    </div>
  </div>

  {images.length > 1 && (
    <div class="ak-carousel__controls">
      <button type="button" class="ak-carousel__arrow" aria-label={labels.prev} data-prev>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M16 10H4M9 15L4 10L9 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <div class="ak-carousel__dots">
        {images.map((_, i) => (
          <button
            type="button"
            class="ak-carousel__dot"
            aria-label={labels.goTo.replace('{n}', String(i + 1))}
            aria-current={i === 0 ? 'true' : undefined}
            data-dot={i}
          />
        ))}
      </div>
      <button type="button" class="ak-carousel__arrow" aria-label={labels.next} data-next>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M4 10H16M11 15L16 10L11 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const n = (i + slides.length) % slides.length;
      track.scrollTo({ left: n * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(current() - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(current() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const i = current();
        dots.forEach((d, j) =>
          j === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current'),
        );
      });
    });
  });
</script>
