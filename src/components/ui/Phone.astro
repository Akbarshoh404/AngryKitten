---
/**
 * Device / Phone — Figma 4:96. A realistic Android phone built in HTML/CSS
 * (frame, bezel, screen, glare, punch-hole camera, side buttons) so any
 * screenshot can be swapped in. Geometry is the Figma 320 × 664 frame,
 * expressed in container units, so it scales cleanly to any width.
 *
 * Styles live in src/styles/components.css (shared with React islands).
 *
 * Pass `src` + `alt` for a single screenshot, or fill the default slot
 * (e.g. a carousel island) to control the screen yourself.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  src?: ImageMetadata;
  alt?: string;
  /** Rendered width in CSS (any length). Default 320px. */
  width?: string;
  /** Image widths for srcset; tune per usage. */
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  shadow?: boolean;
  class?: string;
};
const {
  src,
  alt = '',
  width = '320px',
  widths = [280, 400, 560, 720],
  sizes = '(min-width: 1024px) 320px, 60vw',
  loading = 'lazy',
  fetchpriority,
  shadow = true,
  class: className,
} = Astro.props;
---

<div class:list={['ak-phone', className]} style={`--phone-w:${width}`}>
  <div class:list={['ak-phone__body', shadow && 'has-shadow']}>
    <div class="ak-phone__bezel"></div>
    <div class="ak-phone__screen">
      {src ? (
        <Image
          src={src}
          alt={alt}
          widths={widths}
          sizes={sizes}
          loading={loading}
          fetchpriority={fetchpriority}
          class="ak-phone__img"
        />
      ) : (
        <slot />
      )}
    </div>
    <div class="ak-phone__glare" aria-hidden="true"></div>
    <div class="ak-phone__camera" aria-hidden="true"></div>
    <div class="ak-phone__btn ak-phone__btn--power" aria-hidden="true"></div>
    <div class="ak-phone__btn ak-phone__btn--volume" aria-hidden="true"></div>
  </div>
</div>
